    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "unocss": "^66.12.0",
    "unplugin-auto-import": "^21.1.0",
